# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Raw datasets (large; rebuild via scripts/download_real_data.py)
data/

# Model weights and caches
*.pt
*.pth
*.zip
.pytest_cache/

# Experiment artefacts: exclude weights and tensorboard, but TRACK results
# metadata so every number has a provenance chain. Note: git cannot re-include
# a file whose parent directory is excluded, so we exclude contents, not dirs.
experiments/**/tensorboard/
experiments/**/logs/
experiments/**/*.zip
experiments/**/*.npy
experiments/**/*.png

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
